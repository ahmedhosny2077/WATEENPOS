{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WATEEN POS",
  "version": "1.0.0",
  "identifier": "com.wateenpos.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WATEEN POS",
        "width": 1366,
        "height": 768,
        "minWidth": 1280,
        "minHeight": 720,
        "center": true,
        "visible": true,
        "theme": "Light",
        "additionalBrowserArgs": "--disable-features=WebContentsForceDark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: blob: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {}
}
